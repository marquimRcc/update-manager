#!/bin/bash

# This script saves the settings for the Update Manager application

# Create the application settings folder
if test ! -e "$HOME/.config/regataos-update"; then
    mkdir -p "$HOME/.config/regataos-update/"
fi

if test ! -e "/tmp/regataos-update/config"; then
    mkdir -p "/tmp/regataos-update/"

    ln -s "$HOME/.config/regataos-update" "/tmp/regataos-update/config"
fi

# Apply the automatic update configuration
function update1() {
    if test -e "$HOME/.config/regataos-update/regataos-update.conf"; then
        if grep -q "^autoupdate=" "$HOME/.config/regataos-update/regataos-update.conf"; then
            sed -i "s/^autoupdate=.*/autoupdate=1/" "$HOME/.config/regataos-update/regataos-update.conf"
        else
            echo "autoupdate=1" >>"$HOME/.config/regataos-update/regataos-update.conf"
        fi
    else
        echo "autoupdate=1" >"$HOME/.config/regataos-update/regataos-update.conf"
    fi

    if test ! -e "/tmp/regataos-update/already_updated.txt"; then
        ps -C zypper >/dev/null
        if [ $? = 1 ]; then
            rm -f "/tmp/regataos-update/status.txt"
            sudo /opt/regataos-update-manager/scripts/regataos-up.sh -check-up-config
            date +%s >"$HOME/.config/regataos-update/last-autoupdate-timestamp"
        fi
    else
        if test -e "/tmp/regataos-update/status.txt"; then
            check_current_status=$(cat "/tmp/regataos-update/status.txt")
            if [[ $(echo "$check_current_status") != *"check-updates"* ]]; then
                echo "show-updates" >"/tmp/regataos-update/status.txt"
            fi
        else
            echo "show-updates" >"/tmp/regataos-update/status.txt"
        fi
    fi
}

function update2() {
    if test -e "$HOME/.config/regataos-update/regataos-update.conf"; then
        if grep -q "^autoupdate=" "$HOME/.config/regataos-update/regataos-update.conf"; then
            sed -i "s/^autoupdate=.*/autoupdate=2/" "$HOME/.config/regataos-update/regataos-update.conf"
        else
            echo "autoupdate=2" >>"$HOME/.config/regataos-update/regataos-update.conf"
        fi
    else
        echo "autoupdate=2" >"$HOME/.config/regataos-update/regataos-update.conf"
    fi

    if test ! -e "/tmp/regataos-update/already_updated.txt"; then
        ps -C zypper >/dev/null
        if [ $? = 1 ]; then
            rm -f "/tmp/regataos-update/status.txt"
            sudo /opt/regataos-update-manager/scripts/regataos-up.sh -check-up-config
        fi
    else
        if test -e "/tmp/regataos-update/status.txt"; then
            check_current_status=$(cat "/tmp/regataos-update/status.txt")
            if [[ $(echo "$check_current_status") != *"check-updates"* ]]; then
                echo "show-updates" >"/tmp/regataos-update/status.txt"
            fi
        else
            echo "show-updates" >"/tmp/regataos-update/status.txt"
        fi
    fi
}

function update3() {
    if test -e "$HOME/.config/regataos-update/regataos-update.conf"; then
        if grep -q "^autoupdate=" "$HOME/.config/regataos-update/regataos-update.conf"; then
            sed -i "s/^autoupdate=.*/autoupdate=3/" "$HOME/.config/regataos-update/regataos-update.conf"
        else
            echo "autoupdate=3" >>"$HOME/.config/regataos-update/regataos-update.conf"
        fi
    else
        echo "autoupdate=3" >"$HOME/.config/regataos-update/regataos-update.conf"
    fi

    echo "never-updates" >"/tmp/regataos-update/status.txt"
    rm -f "/tmp/regataos-update/all-auto-update.txt"
    rm -f "/tmp/regataos-update/install-updates.txt"
    echo "" >"/tmp/regataos-update/stop-all-update.txt"
    sudo /opt/regataos-update-manager/scripts/regataos-up-cancel-all.sh
    sudo /opt/regataos-update-manager/scripts/regataos-up.sh -stop-up
    echo "never-updates" >"/tmp/regataos-update/status.txt"
}

# Apply update frequency configuration
function set_frequency() {
    local freq="$1"
    if test ! -e "$HOME/.config/regataos-update"; then
        mkdir -p "$HOME/.config/regataos-update/"
    fi

    if test -e "$HOME/.config/regataos-update/regataos-update.conf"; then
        if grep -q "^frequency=" "$HOME/.config/regataos-update/regataos-update.conf"; then
            sed -i "s/^frequency=.*/frequency=$freq/" "$HOME/.config/regataos-update/regataos-update.conf"
        else
            echo "frequency=$freq" >>"$HOME/.config/regataos-update/regataos-update.conf"
        fi
    else
        echo "autoupdate=1" >"$HOME/.config/regataos-update/regataos-update.conf"
        echo "frequency=$freq" >>"$HOME/.config/regataos-update/regataos-update.conf"
    fi

    local timestamp_file="$HOME/.config/regataos-update/last-autoupdate-timestamp"
    if test ! -e "$timestamp_file"; then
        date +%s >"$timestamp_file"
    fi
}

function update_button() {
    rm -f "/tmp/regataos-update/installing-application-other-updates.txt"
    rm -f "/tmp/regataos-update/downloadable-application-other-updates.txt"
    rm -f "/tmp/regataos-update/system-update-installed.txt"
    rm -f "/tmp/regataos-update/waiting-for-installation.txt"
    rm -f "/tmp/regataos-update/installing-system-update.txt"
    rm -f "/tmp/regataos-update/downloading-system-update.txt"

    ps -C zypper >/dev/null
    if [ $? = 1 ]; then
        rm -f "/tmp/regataos-update/already_updated.txt"
        rm -f "/tmp/regataos-update/status.txt"
        sudo /opt/regataos-update-manager/scripts/regataos-up.sh -check-now
    fi
}

# Run options
case $1 in
"-update-1")
    update1
    ;;
"-update-2")
    update2
    ;;
"-update-3")
    update3
    ;;
"-update-button")
    update_button
    ;;
"-set-mirror")
    /opt/regataos-update-manager/scripts/set-mirror.sh "$2"
    ;;
"-frequency-daily")
    set_frequency "daily"
    ;;
"-frequency-weekly")
    set_frequency "weekly"
    ;;
"-frequency-monthly")
    set_frequency "monthly"
    ;;
"-frequency-sixmonths")
    set_frequency "sixmonths"
    ;;
*)
    echo "Invalid option!"
    exit 1
    ;;
esac
