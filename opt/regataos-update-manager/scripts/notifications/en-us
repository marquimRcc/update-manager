function up_system() {
    notify-send -i regataos-up-mg-none-notify -u normal -a 'Regata OS Update' "Installing updates..." "Automatic update is enabled."
}

function upd_system() {
    notify-send -i regataos-up-mg-none-notify -u normal -a 'Regata OS Update' "Updated system!" "The system has been successfully updated."
}

function bg_running() {
    notify-send -i regataos-up-mg-none-notify -u normal -a 'Regata OS Update' "Regata OS Update" "The application continues running in the background."
}

# Run options
case $1 in
    "-check-up") check_update
        ;;
    "-no-up") no_update
        ;;
    "-show-up") show_update
        ;;
    "-up-system") up_system
        ;;
    "-upd-system") upd_system
        ;;
    "-bg-running") bg_running
        ;;
   *) echo "Invalid option!"
      exit 1
      ;;
esac
