#!/bin/bash

# Show the Update Manager window
function show_up_window() {
    ps -C "regataosupdate" > /dev/null
    if [ $? = 0 ]; then
        touch "/tmp/regataos-update/show-window.txt"
    else
        cd /usr/share/applications/; gtk-launch "regataos-update-manager.desktop"
    fi
}

# Show/hide the Update Manager window, keeping the icon in the system tray.
function show_hide_up_window() {
    ps -C "regataosupdate" > /dev/null
    if [ $? = 1 ]; then
        show_up_window
    else
        touch "/tmp/regataos-update/toggle-window.txt"
    fi
}

# Install updates
function install_updates() {
    ps -C "regataosupdate" > /dev/null
    if [ $? = 0 ]; then
        touch "/tmp/regataos-update/show-window.txt"
    else
        cd /usr/share/applications/
        gtk-launch "regataos-update-manager.desktop"
    fi
    echo "" > "/tmp/regataos-update/install-updates.txt"
}

# Normal close application
function close_app() {
    touch "/tmp/regataos-update/force-quit.txt"
    sleep 0.2
    ps -C "regataosupdate" >/dev/null && killall regataosupdate 2>/dev/null
    killall alert-update.py check-update.py install-update.py 2>/dev/null
}

# Force close application and cancel all updates
function force_close_app() {
    touch "/tmp/regataos-update/force-quit.txt"
    touch "/tmp/regataos-update/stop-all-update.txt"

    # Cancel all running updates
    sudo /opt/regataos-update-manager/scripts/regataos-up-cancel-all.sh 2>/dev/null
    rm -f "/tmp/regataos-update/all-auto-update.txt"
    rm -f "/tmp/regataos-update/install-updates.txt"

    # Stop any background updater processes
    killall -9 zypper 2>/dev/null
    killall -9 aria2c 2>/dev/null
    killall -9 wget 2>/dev/null
    killall -9 regataos-up.sh 2>/dev/null
    killall -9 regataos-up-all.sh 2>/dev/null
    killall -9 regataos-check-up.sh 2>/dev/null

    sleep 0.2
    ps -C "regataosupdate" >/dev/null && killall regataosupdate 2>/dev/null
    killall alert-update.py check-update.py install-update.py 2>/dev/null
}

# Run options.
case $1 in
    "-show-up-app") show_up_window
      ;;
    "-show-hide-up") show_hide_up_window
      ;;
    "-install-updates") install_updates
      ;;
    "-close-app") close_app
      ;;
    "-force-close-app") force_close_app
      ;;
   *) echo "Invalid option!"
      exit 1
      ;;
esac
